# =============================================================================
# Shared git configuration — installed as an [include] from ~/.gitconfig
# =============================================================================
# setup.sh adds:
#   [include]
#       path = ~/git/terminal-setup/git/gitconfig
# to ~/.gitconfig, so edits here take effect immediately with no re-run, and
# your identity/credentials stay in ~/.gitconfig (never in this repo).
#
# Anything you set directly in ~/.gitconfig AFTER the include wins, so local
# overrides remain possible.
# =============================================================================

[core]
    # delta renders diffs with syntax highlighting and proper word-level
    # intra-line diffs. Installed by setup.sh and pinned in versions.lock.
    pager = delta
    editor = nvim

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true          ; n / N jump between files in the pager
    line-numbers = true
    side-by-side = false     ; set true if you prefer split diffs in the terminal
    syntax-theme = Catppuccin Mocha
    hyperlinks = true

[rerere]
    # REuse REcorded REsolution. The single biggest rebase quality-of-life
    # setting: git records how you resolved each conflict and replays that
    # resolution automatically the next time the same conflict appears. When a
    # rebase goes wrong and you abort and retry, you don't redo the work.
    enabled = true
    autoUpdate = true

[rebase]
    autosquash = true        ; `commit --fixup` commits reorder themselves
    autostash = true         ; dirty tree no longer blocks a rebase
    missingCommitsCheck = warn
    ; rebase.updateRefs needs git >= 2.38 — set in gitconfig.local when supported

[merge]
    ; conflictstyle is set in gitconfig.local, because the VALUE is validated by
    ; git: `zdiff3` needs git >= 2.35 and older git dies with
    ;   error: unknown style 'zdiff3' given for 'merge.conflictstyle'
    ; on every command. setup.sh picks zdiff3 or diff3 per machine. Both show
    ; the common ancestor alongside both sides, which is the point; zdiff3 just
    ; additionally compacts lines common to both.
    ; Keep fugitive's :Gvdiffsplit as the 3-way merge tool.
    tool = nvimdiff
    ff = false

[mergetool]
    prompt = false
    keepBackup = false

[mergetool "nvimdiff"]
    cmd = nvim -d "$LOCAL" "$BASE" "$REMOTE" "$MERGED" -c 'wincmd w' -c 'wincmd J'

[diff]
    # histogram produces noticeably better hunks than the default myers,
    # especially on reordered or reindented code.
    algorithm = histogram
    colorMoved = default     ; moved blocks shown in a distinct colour
    colorMovedWS = allow-indentation-change
    mnemonicPrefix = true    ; i/w/c/o prefixes instead of a/b
    renames = copies

[pull]
    rebase = true            ; never create accidental merge commits

[push]
    default = current
    followTags = true
    ; push.autoSetupRemote needs git >= 2.37 — set in gitconfig.local

[fetch]
    prune = true             ; delete local refs for branches gone from remote
    pruneTags = true
    ; fetch.all needs git >= 2.41 — set in gitconfig.local

[branch]
    sort = -committerdate    ; most recently worked-on branches first

[tag]
    sort = -version:refname

[column]
    ui = auto                ; multi-column branch/tag/status output

[status]
    showUntrackedFiles = all
    submoduleSummary = true

[log]
    date = iso

; init.defaultBranch (git >= 2.28) and help.autocorrect=prompt (git >= 2.37,
; and older git rejects a non-numeric value outright) are both set per machine
; in gitconfig.local.

[commit]
    verbose = true           ; full diff in the commit message buffer

[blame]
    coloring = highlightRecent
    markIgnoredLines = true
    markUnblamableLines = true

# --- Aliases: the rebase/history toolkit ------------------------------------
[alias]
    # History
    lg = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
    last = log -1 HEAD --stat
    # Rebase workflow
    ri = rebase -i
    rc = rebase --continue
    ra = rebase --abort
    rs = rebase --skip
    # Interactive rebase onto the merge-base with the default branch — the
    # "clean up my branch before review" command.
    cleanup = "!f() { git rebase -i $(git merge-base HEAD ${1:-origin/main}); }; f"
    fix = commit --fixup
    squash = commit --squash
    amend = commit --amend --no-edit
    # Conflict inspection
    conflicts = diff --name-only --diff-filter=U
    ours = checkout --ours
    theirs = checkout --theirs
    # Safety
    undo = reset --soft HEAD~1
    pushf = push --force-with-lease
    # Browsing
    wip = "!git add -A && git commit -m 'wip'"
    unstage = restore --staged

; ---------------------------------------------------------------------------
; Per-machine, version-gated settings.
;
; Generated by setup.sh from the local git version and NOT committed, because
; this repo is shared between machines with different git versions (macOS ships
; 2.50, Ubuntu 20.04 ships 2.24). Settings whose value git validates — notably
; merge.conflictstyle — must match the git that will read them, or every git
; command fails. A missing include is silently ignored, so this is safe before
; setup.sh has run.
;
; Relative paths in an include are resolved against this file's directory.
; ---------------------------------------------------------------------------
[include]
    path = gitconfig.local
